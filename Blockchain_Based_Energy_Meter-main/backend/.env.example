# ============================================================
# Enargy Backend – Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# Server
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enargy
DB_USER=postgres
DB_PASSWORD=yourpassword

# API Security
API_KEY=EB_SECURE_KEY_123

# Blockchain (Hardhat local network or any Ethereum-compatible network)
# After deploying contract, paste the contract address below
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8547
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Private key of the deployer account (from Hardhat test accounts)
PRIVATE_KEY=

# Optional Sepolia deployment credentials (never commit real values)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret
